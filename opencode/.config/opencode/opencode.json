{
  "$schema": "https://opencode.ai/config.json",
  "model": "ju-tp2/qwen3.5-9b",
  "provider": {
    "ju-tp2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp on ju-TP2",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B UD-Q5_K_XL",
          "limit": {
            "context": 98304,
            "output": 16384
          }
        }
      }
    }
  },
  "instructions": [".claude/CLAUDE.md", ".claude/memory/MEMORY.md"],
  "skills": {
    "paths": ["~/.local/share/opencode-claude-skills"]
  },
  "permission": {
    "bash": {
      "*": "ask",
      "rg *": "allow",
      "fdfind *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "readlink *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "command -v *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "shellcheck *": "allow",
      "shellharden *": "allow",
      "shfmt *": "allow",
      "bats *": "allow",
      "air *": "allow",
      "jarl *": "allow",
      "ruff *": "allow",
      "pyrefly *": "allow",
      "prose-lint *": "allow",
      "panache *": "allow",
      "stylelint *": "allow",
      "prettier *": "allow",
      "sqlfluff *": "allow",
      "stylua *": "allow",
      "typstyle *": "allow",
      "curl *better-bibtex/json-rpc*": "deny",
      "*>*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/.claude/**": "allow",
      "~/.local/share/opencode-claude-skills/**": "allow"
    },
    "skill": {
      "*": "allow",
      "blindspot": "ask",
      "claude-automation-recommender": "ask",
      "commit": "ask",
      "depouiller": "ask",
      "design": "ask",
      "implement": "ask",
      "mcp-adversary": "ask",
      "new-work": "ask",
      "relire": "ask",
      "skill-adversary": "ask",
      "walkthrough": "ask",
      "working-on": "ask",
      "auto": "deny",
      "brownfield": "deny",
      "cancel": "deny",
      "ouroboros-config": "deny",
      "evaluate": "deny",
      "evolve": "deny",
      "ouroboros-help": "deny",
      "interview": "deny",
      "ooo": "deny",
      "pm": "deny",
      "publish": "deny",
      "qa": "deny",
      "ralph": "deny",
      "resume-session": "deny",
      "ouroboros-run": "deny",
      "seed": "deny",
      "setup": "deny",
      "ouroboros-status": "deny",
      "tutorial": "deny",
      "unstuck": "deny",
      "update": "deny",
      "welcome": "deny",
      "litrev": "deny",
      "litrev-extract": "deny",
      "litrev-screen": "deny",
      "litrev-search": "deny",
      "litrev-synthesize": "deny",
      "docs": "deny",
      "morning": "deny",
      "import-memory": "deny"
    }
  }
}
