#!/usr/bin/env bash
set -euo pipefail

for _cmd in jq curl gh; do
  command -v "$_cmd" >/dev/null 2>&1 || {
    printf '%s is required\n' "$_cmd" >&2
    exit 1
  }
done

case "$(uname -m)" in
x86_64) ASSET_RE='linux.*x86_64\.tar\.zst$|linux\.tar\.zst$' ;;
aarch64 | arm64) ASSET_RE='linux.*(aarch64|arm64)\.tar\.zst$' ;;
*)
  echo "Unsupported architecture: $(uname -m)" >&2
  exit 1
  ;;
esac

RELEASE=$(gh api "repos/ankitects/anki/releases?per_page=20" \
  --jq 'map(select(.prerelease == false and (.assets | length > 0))) | .[0]')

if [ "$RELEASE" = "" ] || [ "$RELEASE" = "null" ]; then
  echo "Failed to resolve latest Anki release from GitHub API" >&2
  exit 1
fi

VER=$(jq -r '.tag_name // ""' <<<"$RELEASE")
TARBALL=$(jq -r --arg re "$ASSET_RE" 'first(.assets[] | select(.name | test($re))) | .name // ""' <<<"$RELEASE")
TARBALL_URL=$(jq -r --arg re "$ASSET_RE" 'first(.assets[] | select(.name | test($re))) | .browser_download_url // ""' <<<"$RELEASE")
CHECKSUMS=$(jq -r 'first(.assets[] | select(.name | test("checksums"))) | .name // ""' <<<"$RELEASE")
CHECKSUMS_URL=$(jq -r 'first(.assets[] | select(.name | test("checksums"))) | .browser_download_url // ""' <<<"$RELEASE")

if [ "$VER" = "" ]; then
  echo "Failed to resolve latest Anki version from GitHub API" >&2
  exit 1
fi
if [ "$TARBALL" = "" ] || [ "$TARBALL_URL" = "" ]; then
  echo "No Linux $(uname -m) tarball found in Anki release ${VER}" >&2
  exit 1
fi

echo "Latest Anki release: ${VER}"

MARKER="${ANKI_MARKER:-/usr/local/share/anki/version}"
CURRENT=$(cat "$MARKER" 2>/dev/null || true)
[ "$CURRENT" != "" ] || CURRENT=unknown

if [ "$CURRENT" = "$VER" ]; then
  echo "Already on ${VER} — nothing to do."
  exit 0
fi

sudo -v

TMP=$(mktemp -d)
SUDO_KEEPALIVE_PID=

cleanup() {
  rc=$?
  if [ "$SUDO_KEEPALIVE_PID" != "" ]; then
    kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
  fi
  rm -rf "$TMP"
  exit "$rc"
}
trap cleanup EXIT

(while true; do
  sleep 60
  sudo -n -v 2>/dev/null || exit
done) &
SUDO_KEEPALIVE_PID=$!

echo "Checking prerequisites..."
sudo apt-get install -y -qq libxcb-xinerama0 libxcb-cursor0 libnss3 zstd

echo "Downloading Anki ${VER} (${TARBALL})..."
curl -fL --progress-bar -o "${TMP}/${TARBALL}" "$TARBALL_URL"

if [ "$CHECKSUMS" != "" ] && [ "$CHECKSUMS_URL" != "" ]; then
  curl -fsSL -o "${TMP}/${CHECKSUMS}" "$CHECKSUMS_URL"
  echo "Verifying checksum..."
  LINE=$(grep -E -- "^[0-9a-f]{64}  ${TARBALL//./\\.}$" "${TMP}/${CHECKSUMS}") || {
    echo "Checksum line missing for ${TARBALL} in ${CHECKSUMS}" >&2
    exit 1
  }
  EXPECTED=$(awk '{print $1}' <<<"$LINE")
  ACTUAL=$(sha256sum "${TMP}/${TARBALL}" | awk '{print $1}')
  if [ "$EXPECTED" != "$ACTUAL" ]; then
    echo "Checksum mismatch for ${TARBALL}" >&2
    printf '  expected: %s\n  actual:   %s\n' "$EXPECTED" "$ACTUAL" >&2
    exit 1
  fi
else
  echo "No checksums asset published for ${VER} — skipping checksum verification." >&2
fi

echo "Extracting..."
tar -xf "${TMP}/${TARBALL}" -C "$TMP"
INSTALL_SH=$(find "$TMP" -maxdepth 3 -name install.sh -print -quit)
if [ "$INSTALL_SH" = "" ]; then
  echo "install.sh missing from extracted archive — aborting" >&2
  exit 1
fi

echo "Installing..."
(cd "$(dirname "$INSTALL_SH")" && sudo ./install.sh)

sudo mkdir -p "$(dirname "$MARKER")"
printf '%s\n' "$VER" | sudo tee "$MARKER" >/dev/null

echo
echo "Installed Anki: ${VER}"
[ "$CURRENT" = "unknown" ] || echo "Previous version: ${CURRENT}"
