#!/usr/bin/env bash
set -euo pipefail

command -v gh >/dev/null 2>&1 || {
  printf 'gh is required\n' >&2
  exit 1
}

# Overridable so the test suite can point them at a temp tree; neither path is
# reachable through PATH stubbing.
PREFIX=${QUARTO_PREFIX:-/opt/quarto}
BIN_LINK=${QUARTO_BIN_LINK:-/usr/local/bin/quarto}

sync_bin_link() {
  local target="${PREFIX}/bin/quarto"
  [ -x "$target" ] || return 0
  [ "$(readlink -f "$BIN_LINK" 2>/dev/null || true)" = "$(readlink -f "$target")" ] && return 0
  if [ -e "$BIN_LINK" ] && [ ! -L "$BIN_LINK" ]; then
    echo "${BIN_LINK} exists and is not a symlink: leaving it alone." >&2
    return 0
  fi
  echo "Pointing ${BIN_LINK} at ${target}..."
  sudo ln -sfn "$target" "$BIN_LINK"
}

VER=$(gh api repos/quarto-dev/quarto-cli/releases/latest --jq '(.tag_name // "") | sub("^v"; "")')
case "$(uname -m)" in
x86_64) ARCH=linux-amd64 ;;
aarch64) ARCH=linux-arm64 ;;
*)
  echo "Unsupported architecture: $(uname -m)" >&2
  exit 1
  ;;
esac
URL=https://github.com/quarto-dev/quarto-cli/releases/download

if [ "$VER" = "" ] || [ "$VER" = "null" ]; then
  echo "Failed to resolve latest Quarto version from GitHub API" >&2
  exit 1
fi

echo "Latest Quarto release: ${VER}"

# Read through the prefix rather than PATH: Positron's integrated terminal puts
# its own bundled quarto first, which would pass for this install.
CURRENT=$("${PREFIX}/bin/quarto" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true)
[ "$CURRENT" != "" ] || CURRENT=unknown
if [ "$CURRENT" = "$VER" ]; then
  sync_bin_link
  echo "Already on ${VER}: nothing to do."
  exit 0
fi

sudo -v

TARBALL=quarto-${VER}-${ARCH}.tar.gz
CHECKSUMS=quarto-${VER}-checksums.txt
BASE_URL=${URL}/v${VER}
TMP=$(mktemp -d)
BACKUP=
[ ! -d "$PREFIX" ] || BACKUP="${PREFIX}.bak-${CURRENT}-$(date +%Y%m%d-%H%M%S)"
SWAPPED=0
SUDO_KEEPALIVE_PID=
cleanup() {
  rc=$?
  if [ "$SUDO_KEEPALIVE_PID" != "" ]; then
    kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
  fi
  if [ "$SWAPPED" = "1" ] && [ "$BACKUP" != "" ] && [ -d "$BACKUP" ]; then
    echo "Install failed after backup: restoring ${BACKUP} to ${PREFIX}" >&2
    { sudo rm -rf "$PREFIX" && sudo mv "$BACKUP" "$PREFIX"; } ||
      echo "Rollback failed: ${BACKUP} still holds the previous install" >&2
  fi
  rm -rf "$TMP"
  exit "$rc"
}
trap cleanup EXIT

(while true; do
  sleep 60
  sudo -n -v 2>/dev/null || exit
done) &
SUDO_KEEPALIVE_PID=$!

if [ "$BACKUP" != "" ] && [ -e "$BACKUP" ]; then
  echo "Backup path ${BACKUP} already exists: remove it first or rename it." >&2
  exit 1
fi

echo "Downloading Quarto ${VER}..."
curl -fL --progress-bar -o "${TMP}/${TARBALL}" "${BASE_URL}/${TARBALL}"
curl -fsSL -o "${TMP}/${CHECKSUMS}" "${BASE_URL}/${CHECKSUMS}"

echo "Verifying checksum..."
LINE=$(grep -E "[[:space:]]${TARBALL}\$" "${TMP}/${CHECKSUMS}") || {
  echo "Checksum line missing for ${TARBALL} in ${CHECKSUMS}" >&2
  exit 1
}
(cd "$TMP" && printf '%s\n' "$LINE" | sha256sum -c -)

echo "Extracting to staging area..."
STAGE="${TMP}/quarto-new"
mkdir -p "$STAGE"
tar -xzf "${TMP}/${TARBALL}" -C "$STAGE" --strip-components=1

if [ ! -x "${STAGE}/bin/quarto" ]; then
  echo "Extracted tree missing bin/quarto: aborting before touching ${PREFIX}" >&2
  exit 1
fi

if ! "${STAGE}/bin/quarto" --version >/dev/null 2>&1; then
  echo "Staged quarto fails to execute: aborting before touching ${PREFIX}" >&2
  exit 1
fi

if [ "$BACKUP" != "" ]; then
  echo "Backing up current install to ${BACKUP}"
  SWAPPED=1
  sudo mv "$PREFIX" "$BACKUP"
else
  echo "No install at ${PREFIX}: first install."
  sudo mkdir -p "$(dirname "$PREFIX")"
fi
sudo mv "$STAGE" "$PREFIX"
sudo chown -R root:root "$PREFIX"
SWAPPED=0

[ "$BACKUP" = "" ] || find "$(dirname "$PREFIX")" -maxdepth 1 -type d -name "$(basename "$PREFIX").bak-*" \
  ! -path "$BACKUP" -exec sudo rm -rf {} +

sync_bin_link

echo
echo "Installed version:"
"${PREFIX}/bin/quarto" --version
echo
echo "Run 'quarto check' to validate the install."
[ "$BACKUP" = "" ] || echo "Backup kept at ${BACKUP}; older backups removed."
