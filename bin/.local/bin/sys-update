#!/usr/bin/env bash
set -Eeuo pipefail

DRY_RUN=0
SELECTED_MODULES=()

ALL_MODULES=(
  apt
  snap
  flatpak
  npm
  rustup
  cargo
  claude
  devtools
  uv-tools
  pnpm
  rv
  rig
  duckdb
  claude-plugins
  quarto
  positron
  anki
)

SUDO_MODULES=(apt snap)

usage() {
  cat <<EOF
sys-update — system and devtools updates

Usage:
  sys-update [options] [module...]

Options:
  --dry-run    print commands without running them
  --list       list available modules
  -h, --help   show this help

Modules:
  $(printf '%s\n' "${ALL_MODULES[@]}" | paste -sd ' ')

With no module argument, all modules run.
EOF
}

list_modules() {
  printf '%-16s %s\n' MODULE SUDO
  for m in "${ALL_MODULES[@]}"; do
    local sudo_flag=no
    for s in "${SUDO_MODULES[@]}"; do
      [[ "$m" == "$s" ]] && sudo_flag=yes && break
    done
    printf '%-16s %s\n' "$m" "$sudo_flag"
  done
}

run_or_dry() {
  if ((DRY_RUN)); then
    printf '  [dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

RESULTS=()

record() {
  local module="$1" status="$2"
  RESULTS+=("$(printf '%-16s %s' "$module" "$status")")
}

update_apt() {
  run_or_dry sudo apt-get update -q
  run_or_dry sudo apt-get full-upgrade -y
  record apt OK
}

update_snap() {
  if ! command -v snap >/dev/null 2>&1; then
    record snap "skipped (not found)"
    return
  fi
  run_or_dry sudo snap refresh
  record snap OK
}

update_flatpak() {
  if ! command -v flatpak >/dev/null 2>&1; then
    record flatpak "skipped (not found)"
    return
  fi
  run_or_dry flatpak update -y
  record flatpak OK
}

update_npm() {
  if ! command -v npm >/dev/null 2>&1; then
    record npm "skipped (not found)"
    return
  fi
  run_or_dry npm update -g
  record npm OK
}

update_rustup() {
  if ! command -v rustup >/dev/null 2>&1; then
    record rustup "skipped (not found)"
    return
  fi
  run_or_dry rustup update
  record rustup OK
}

update_cargo() {
  if ! command -v cargo-install-update >/dev/null 2>&1; then
    record cargo "skipped (cargo-update not found)"
    return
  fi
  run_or_dry cargo install-update -a
  record cargo OK
}

update_claude() {
  if ! command -v claude >/dev/null 2>&1; then
    record claude "skipped (not found)"
    return
  fi
  run_or_dry claude update
  record claude OK
}

update_devtools() {
  if ! command -v devtools-update >/dev/null 2>&1; then
    record devtools "skipped (not found)"
    return
  fi
  run_or_dry devtools-update --all
  record devtools OK
}

update_uv-tools() {
  if ! command -v uv >/dev/null 2>&1; then
    record uv-tools "skipped (not found)"
    return
  fi
  run_or_dry uv tool upgrade --all
  record uv-tools OK
}

update_pnpm() {
  if ! command -v pnpm >/dev/null 2>&1; then
    record pnpm "skipped (not found)"
    return
  fi
  run_or_dry pnpm self-update
  record pnpm OK
}

update_rv() {
  if ! command -v rv-update >/dev/null 2>&1; then
    record rv "skipped (not found)"
    return
  fi
  run_or_dry rv-update
  record rv OK
}

update_rig() {
  if ! command -v rig-update >/dev/null 2>&1; then
    record rig "skipped (not found)"
    return
  fi
  run_or_dry rig-update
  record rig OK
}

update_duckdb() {
  if ! command -v duckdb-update >/dev/null 2>&1; then
    record duckdb "skipped (not found)"
    return
  fi
  run_or_dry duckdb-update
  record duckdb OK
}

update_claude-plugins() {
  if ! command -v claude-plugins-update >/dev/null 2>&1; then
    record claude-plugins "skipped (not found)"
    return
  fi
  run_or_dry claude-plugins-update
  record claude-plugins OK
}

update_quarto() {
  if ! command -v quarto-update >/dev/null 2>&1; then
    record quarto "skipped (not found)"
    return
  fi
  run_or_dry quarto-update
  record quarto OK
}

update_positron() {
  if ! command -v positron-update >/dev/null 2>&1; then
    record positron "skipped (not found)"
    return
  fi
  run_or_dry positron-update
  record positron OK
}

update_anki() {
  if ! command -v anki-update >/dev/null 2>&1; then
    record anki "skipped (not found)"
    return
  fi
  run_or_dry anki-update
  record anki OK
}

needs_sudo() {
  local modules=("$@")
  for m in "${modules[@]}"; do
    for s in "${SUDO_MODULES[@]}"; do
      [[ "$m" == "$s" ]] && return 0
    done
  done
  return 1
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      usage
      return 0
      ;;
    --list)
      list_modules
      return 0
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -*)
      printf 'sys-update: unknown option: %s\n' "$1" >&2
      return 2
      ;;
    *)
      SELECTED_MODULES+=("$1")
      shift
      ;;
    esac
  done

  if [[ ${#SELECTED_MODULES[@]} -eq 0 ]]; then
    SELECTED_MODULES=("${ALL_MODULES[@]}")
  fi

  for m in "${SELECTED_MODULES[@]}"; do
    local found=0
    for known in "${ALL_MODULES[@]}"; do
      [[ "$m" == "$known" ]] && found=1 && break
    done
    if ((found == 0)); then
      printf 'sys-update: unknown module: %s\n' "$m" >&2
      return 2
    fi
  done

  if ! ((DRY_RUN)) && needs_sudo "${SELECTED_MODULES[@]}"; then
    sudo -v
  fi

  for m in "${SELECTED_MODULES[@]}"; do
    printf '→ %s\n' "$m"
    "update_${m}"
  done

  printf '\n%-16s %s\n' MODULE STATUS
  printf '%s\n' "$(printf '%.0s-' {1..35})"
  for line in "${RESULTS[@]}"; do
    printf '%s\n' "$line"
  done
  printf '%s\n' "$(printf '%.0s-' {1..30})"
}

main "$@"
