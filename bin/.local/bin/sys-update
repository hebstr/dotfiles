#!/usr/bin/env bash
set -Eeuo pipefail

DRY_RUN=0
SELECTED_MODULES=()

ALL_MODULES=(
  apt
  snap
  flatpak
  npm
  rustup
  cargo
  claude
  devtools
  uv-python
  uv-tools
  rv
  rig
  gh
  duckdb
  lua-toolchain
  css-toolchain
  claude-plugins
  agent-skills
  quarto
  pandoc
  positron
  anki
  libreoffice
  syncthing
)

SUDO_MODULES=(apt snap devtools rig gh quarto pandoc positron anki libreoffice syncthing)

usage() {
  cat <<EOF
sys-update: system and devtools updates

Usage:
  sys-update [options] [module...]

Options:
  --dry-run    print commands without running them
  --list       list available modules
  -h, --help   show this help

Modules:
  $(printf '%s\n' "${ALL_MODULES[@]}" | paste -sd ' ')

With no module argument, all modules run.
EOF
}

list_modules() {
  printf '%-16s %s\n' MODULE SUDO
  for m in "${ALL_MODULES[@]}"; do
    local sudo_flag=no
    for s in "${SUDO_MODULES[@]}"; do
      [[ "$m" == "$s" ]] && sudo_flag=yes && break
    done
    printf '%-16s %s\n' "$m" "$sudo_flag"
  done
}

run_or_dry() {
  if ((DRY_RUN)); then
    printf '  [dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

RESULTS=()
ANY_FAIL=0

record() {
  local module="$1" status="$2"
  RESULTS+=("$(printf '%-16s %s' "$module" "$status")")
}

print_summary() {
  ((${#RESULTS[@]} == 0)) && return
  printf '\n%-16s %s\n' MODULE STATUS
  printf -- '-----------------------------------\n'
  for line in "${RESULTS[@]}"; do
    printf '%s\n' "$line"
  done
  printf -- '-----------------------------------\n'
}
trap print_summary EXIT
trap 'exit 130' INT

update_apt() {
  local index_ok=1
  # apt keeps a failed repository's previous index, so upgrading stays safe.
  run_or_dry sudo apt-get update -q --error-on=any || index_ok=0
  run_or_dry sudo apt-get full-upgrade -y || return
  if ((index_ok)); then
    record apt OK
  else
    record apt "FAIL (index refresh)"
    ANY_FAIL=1
  fi
}

update_snap() {
  if ! command -v snap >/dev/null 2>&1; then
    record snap "skipped (not found)"
    return
  fi
  run_or_dry sudo snap refresh && record snap OK
}

update_flatpak() {
  if ! command -v flatpak >/dev/null 2>&1; then
    record flatpak "skipped (not found)"
    return
  fi
  run_or_dry flatpak update -y && record flatpak OK
}

update_npm() {
  if ! command -v npm >/dev/null 2>&1; then
    record npm "skipped (not found)"
    return
  fi
  run_or_dry npm update -g && record npm OK
}

update_rustup() {
  if ! command -v rustup >/dev/null 2>&1; then
    record rustup "skipped (not found)"
    return
  fi
  run_or_dry rustup update && record rustup OK
}

update_cargo() {
  if ! command -v cargo-install-update >/dev/null 2>&1; then
    record cargo "skipped (cargo-update not found)"
    return
  fi
  # tree-sitter-ggsql's build script regenerates the parser unless this is set,
  # which requires tree-sitter-cli; the published crate already ships src/parser.c
  run_or_dry env GGSQL_SKIP_GENERATE=1 cargo install-update -a && record cargo OK
}

update_claude() {
  if ! command -v claude >/dev/null 2>&1; then
    record claude "skipped (not found)"
    return
  fi
  run_or_dry claude update && record claude OK
}

update_devtools() {
  if ! command -v devtools-update >/dev/null 2>&1; then
    record devtools "skipped (not found)"
    return
  fi
  run_or_dry devtools-update --all && record devtools OK
}

# Distinct from uv-tools: `uv tool upgrade` updates packages inside the tool
# venvs and never the interpreter they run on, which nothing else here tracks.
update_uv_python() {
  if ! command -v uv >/dev/null 2>&1; then
    record uv-python "skipped (not found)"
    return
  fi
  run_or_dry uv python upgrade && record uv-python OK
}

update_uv_tools() {
  if ! command -v uv >/dev/null 2>&1; then
    record uv-tools "skipped (not found)"
    return
  fi
  run_or_dry uv tool upgrade --all && record uv-tools OK
}

update_rv() {
  if ! command -v rv-update >/dev/null 2>&1; then
    record rv "skipped (not found)"
    return
  fi
  run_or_dry rv-update && record rv OK
}

update_rig() {
  if ! command -v rig-update >/dev/null 2>&1; then
    record rig "skipped (not found)"
    return
  fi
  run_or_dry rig-update && record rig OK
}

update_gh() {
  if ! command -v gh-update >/dev/null 2>&1; then
    record gh "skipped (not found)"
    return
  fi
  run_or_dry gh-update && record gh OK
}

update_duckdb() {
  if ! command -v duckdb-update >/dev/null 2>&1; then
    record duckdb "skipped (not found)"
    return
  fi
  run_or_dry duckdb-update && record duckdb OK
}

update_lua_toolchain() {
  if ! command -v lua-toolchain-update >/dev/null 2>&1; then
    record lua-toolchain "skipped (not found)"
    return
  fi
  run_or_dry lua-toolchain-update && record lua-toolchain OK
}

update_css_toolchain() {
  if ! command -v css-toolchain-update >/dev/null 2>&1; then
    record css-toolchain "skipped (not found)"
    return
  fi
  run_or_dry css-toolchain-update && record css-toolchain OK
}

update_claude_plugins() {
  if ! command -v claude-plugins-update >/dev/null 2>&1; then
    record claude-plugins "skipped (not found)"
    return
  fi
  run_or_dry claude-plugins-update && record claude-plugins OK
}

update_agent_skills() {
  if ! command -v agent-skills-update >/dev/null 2>&1; then
    record agent-skills "skipped (not found)"
    return
  fi
  run_or_dry agent-skills-update && record agent-skills OK
}

update_quarto() {
  if ! command -v quarto-update >/dev/null 2>&1; then
    record quarto "skipped (not found)"
    return
  fi
  run_or_dry quarto-update && record quarto OK
}

update_pandoc() {
  if ! command -v pandoc-update >/dev/null 2>&1; then
    record pandoc "skipped (not found)"
    return
  fi
  run_or_dry pandoc-update && record pandoc OK
}

# The application updaters install the app when it is absent, so these modules
# also require the app itself: stow bin puts the updaters on machines (WSL) that
# must never get the desktop applications.
update_positron() {
  if ! command -v positron-update >/dev/null 2>&1; then
    record positron "skipped (not found)"
    return
  fi
  if ! command -v positron >/dev/null 2>&1; then
    record positron "skipped (positron not installed)"
    return
  fi
  run_or_dry positron-update && record positron OK
}

update_anki() {
  if ! command -v anki-update >/dev/null 2>&1; then
    record anki "skipped (not found)"
    return
  fi
  if ! command -v anki >/dev/null 2>&1; then
    record anki "skipped (anki not installed)"
    return
  fi
  run_or_dry anki-update && record anki OK
}

update_libreoffice() {
  if ! command -v libreoffice-update >/dev/null 2>&1; then
    record libreoffice "skipped (not found)"
    return
  fi
  if ! command -v libreoffice >/dev/null 2>&1; then
    record libreoffice "skipped (libreoffice not installed)"
    return
  fi
  run_or_dry libreoffice-update && record libreoffice OK
}

update_syncthing() {
  if ! command -v syncthing-update >/dev/null 2>&1; then
    record syncthing "skipped (not found)"
    return
  fi
  run_or_dry syncthing-update && record syncthing OK
}

needs_sudo() {
  local modules=("$@")
  for m in "${modules[@]}"; do
    for s in "${SUDO_MODULES[@]}"; do
      [[ "$m" == "$s" ]] && return 0
    done
  done
  return 1
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      usage
      return 0
      ;;
    --list)
      list_modules
      return 0
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -*)
      printf 'sys-update: unknown option: %s\n' "$1" >&2
      return 2
      ;;
    *)
      SELECTED_MODULES+=("$1")
      shift
      ;;
    esac
  done

  if [[ ${#SELECTED_MODULES[@]} -eq 0 ]]; then
    SELECTED_MODULES=("${ALL_MODULES[@]}")
  fi

  local -A seen=()
  local uniq=()
  for m in "${SELECTED_MODULES[@]}"; do
    [[ -n ${seen[$m]:-} ]] && continue
    seen[$m]=1
    uniq+=("$m")
  done
  SELECTED_MODULES=("${uniq[@]}")

  for m in "${SELECTED_MODULES[@]}"; do
    local found=0
    for known in "${ALL_MODULES[@]}"; do
      [[ "$m" == "$known" ]] && found=1 && break
    done
    if ((found == 0)); then
      printf 'sys-update: unknown module: %s\n' "$m" >&2
      return 2
    fi
  done

  if ! ((DRY_RUN)) && needs_sudo "${SELECTED_MODULES[@]}"; then
    sudo -v
  fi

  for m in "${SELECTED_MODULES[@]}"; do
    printf '→ %s\n' "$m"
    if "update_${m//-/_}"; then
      :
    else
      record "$m" "FAIL (exit $?)"
      ANY_FAIL=1
    fi
  done

  return "$ANY_FAIL"
}

main "$@"
