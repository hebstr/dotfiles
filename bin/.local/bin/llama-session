#!/usr/bin/env bash
set -Eeuo pipefail

REMOTE=${LLAMA_REMOTE:-ju-TP2}
PORT=${LLAMA_PORT:-8080}
REPO=${LLAMA_MODEL_REPO:-unsloth/Qwen3.5-4B-GGUF}
FILE=${LLAMA_MODEL_FILE:-Qwen3.5-4B-UD-Q4_K_XL.gguf}
CTX=${LLAMA_CTX:-40960}
PARALLEL=${LLAMA_PARALLEL:-1}
NGL=${LLAMA_NGL:-99}
ALIAS=${LLAMA_ALIAS:-}
READY_TIMEOUT=${LLAMA_READY_TIMEOUT:-180}

REMOTE_BIN=.local/opt/llama.cpp/llama-server
REMOTE_HF=.local/bin/hf
REMOTE_LOG=/tmp/llama-server.log

KEEP=0
STARTED_HERE=0
TUNNEL_PID=
ACTION=up

usage() {
  cat <<'EOF'
Usage: llama-session [--keep] [--stop] [--status] [-h | --help]

Brings up a llama-server session on the remote GPU host and forwards its port
to localhost, then holds until interrupted.

  --keep     leave the remote server running on exit, even if started here
  --stop     stop the remote server and exit
  --status   report remote and local state, then exit
  -h, --help show this help

Environment: LLAMA_REMOTE LLAMA_PORT LLAMA_MODEL_REPO LLAMA_MODEL_FILE
             LLAMA_CTX LLAMA_PARALLEL LLAMA_NGL LLAMA_ALIAS LLAMA_READY_TIMEOUT
EOF
}

die() {
  printf 'llama-session: %s\n' "$1" >&2
  exit 1
}

remote() {
  ssh -o BatchMode=yes "$REMOTE" "$@" </dev/null
}

server_running() {
  local rc=0
  remote 'pgrep -x llama-server >/dev/null' 2>/dev/null || rc=$?
  if [ "$rc" -eq 255 ]; then
    return 2
  fi
  [ "$rc" -eq 0 ]
}

unreachable_warning() {
  printf 'llama-session: cannot reach %s, llama-server may still be running there; run llama-session --stop later\n' "$REMOTE" >&2
}

stop_server() {
  local rc=0
  remote 'pkill -x llama-server' >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 255 ]; then
    unreachable_warning
    return 1
  fi
  for ((i = 0; i < 15; i++)); do
    rc=0
    server_running || rc=$?
    [ "$rc" -ne 1 ] || return 0
    sleep 2
  done
  if [ "$rc" -eq 2 ]; then
    unreachable_warning
    return 1
  fi
  remote 'pkill -9 -x llama-server' >/dev/null 2>&1 || true
  sleep 1
  rc=0
  server_running || rc=$?
  case $rc in
  1) return 0 ;;
  2)
    unreachable_warning
    return 1
    ;;
  esac
  printf 'llama-session: llama-server still running on %s after SIGKILL\n' "$REMOTE" >&2
  return 1
}

start_server() {
  local model
  printf 'resolving %s (%s), downloading if absent\n' "$REPO" "$FILE"
  model=$(remote "${REMOTE_HF} download $(printf '%q %q' "$REPO" "$FILE") -q | tail -1" | tr -d '\r')
  [ "$model" != "" ] || die "could not resolve the model on ${REMOTE}"

  local alias=${ALIAS:-${FILE%.gguf}}
  printf 'starting llama-server on %s, ctx %s, %s layers offloaded\n' "$REMOTE" "$CTX" "$NGL"
  remote "setsid nohup ${REMOTE_BIN} \
    --model $(printf '%q' "$model") \
    --alias $(printf '%q' "$alias") \
    --host 127.0.0.1 --port $(printf '%q' "$PORT") \
    -ngl $(printf '%q' "$NGL") \
    --ctx-size $(printf '%q' "$CTX") \
    --parallel $(printf '%q' "$PARALLEL") \
    --jinja --reasoning-budget 0 \
    >${REMOTE_LOG} 2>&1 &" >/dev/null
  STARTED_HERE=1
}

check_reused() {
  local cmdline alias=${ALIAS:-${FILE%.gguf}}
  cmdline=" $(remote 'pgrep -a -x llama-server' 2>/dev/null || true) "
  case $cmdline in
  *" --port ${PORT} "*) ;;
  *" --port "*) die "the llama-server on ${REMOTE} listens on another port than ${PORT}; stop it with llama-session --stop or set LLAMA_PORT" ;;
  esac
  case $cmdline in
  *" --alias ${alias} "*" --ctx-size ${CTX} "*) ;;
  *) printf 'warning: the reused server was not started as %s with ctx %s; run llama-session --stop first to switch\n' "$alias" "$CTX" >&2 ;;
  esac
}

open_tunnel() {
  ssh -o BatchMode=yes -o ExitOnForwardFailure=yes -N -L "${PORT}:127.0.0.1:${PORT}" "$REMOTE" &
  TUNNEL_PID=$!
}

wait_ready() {
  local deadline=$((SECONDS + READY_TIMEOUT)) rc
  while [ "$SECONDS" -lt "$deadline" ]; do
    rc=0
    server_running || rc=$?
    if [ "$rc" -eq 1 ]; then
      printf 'llama-server died at startup on %s, last log lines:\n' "$REMOTE" >&2
      remote "tail -15 ${REMOTE_LOG}" >&2 || true
      return 1
    fi
    if curl -sf "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
      return 0
    fi
    if ! kill -0 "$TUNNEL_PID" 2>/dev/null; then
      printf 'port forward on %s to %s failed\n' "$PORT" "$REMOTE" >&2
      return 1
    fi
    sleep 2
  done
  printf 'llama-server still not answering after %ss, it is alive but loading\n' "$READY_TIMEOUT" >&2
  return 1
}

cleanup() {
  if [ "$TUNNEL_PID" != "" ]; then
    kill "$TUNNEL_PID" 2>/dev/null || true
  fi
  if [ "$STARTED_HERE" -eq 1 ] && [ "$KEEP" -eq 0 ]; then
    printf '\nstopping the remote server\n'
    stop_server
  fi
}

status() {
  local rc=0
  server_running || rc=$?
  case $rc in
  0)
    printf 'remote: llama-server running on %s\n' "$REMOTE"
    remote "curl -sf http://127.0.0.1:${PORT}/v1/models" 2>/dev/null |
      sed -n 's/.*"id":"\([^"]*\)".*/remote: model \1/p' || true
    ;;
  1) printf 'remote: no llama-server on %s\n' "$REMOTE" ;;
  *) printf 'remote: cannot reach %s\n' "$REMOTE" ;;
  esac
  if curl -sf "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
    printf 'local: port %s answers\n' "$PORT"
  else
    printf 'local: port %s silent, no forward\n' "$PORT"
  fi
}

while [ $# -gt 0 ]; do
  case $1 in
  --keep) KEEP=1 ;;
  --stop) ACTION=stop ;;
  --status) ACTION=status ;;
  -h | --help)
    usage
    exit 0
    ;;
  *) die "unknown argument: $1" ;;
  esac
  shift
done

case $ACTION in
status)
  status
  exit 0
  ;;
stop)
  rc=0
  server_running || rc=$?
  case $rc in
  0)
    stop_server
    printf 'remote server stopped\n'
    ;;
  1) printf 'no remote server to stop\n' ;;
  *) die "cannot reach ${REMOTE}" ;;
  esac
  exit 0
  ;;
esac

if curl -sf "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
  die "port ${PORT} already answers locally, and not through this session's forward"
fi

trap 'exit 130' INT
trap 'exit 143' TERM
trap cleanup EXIT

rc=0
server_running || rc=$?
case $rc in
0)
  printf 'reusing the llama-server already running on %s\n' "$REMOTE"
  check_reused
  ;;
1) start_server ;;
*) die "cannot reach ${REMOTE}" ;;
esac

open_tunnel
if ! wait_ready; then
  exit 1
fi

printf 'ready: http://127.0.0.1:%s/v1; run opencode, interrupt here to tear down\n' "$PORT"
wait "$TUNNEL_PID"
