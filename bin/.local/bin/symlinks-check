#!/usr/bin/env bash
set -euo pipefail

mapfile -d '' -t links < <(
  find ~/ \
    \( -path "$HOME/.cache" -o -path "$HOME/.local/share" -o -path "$HOME/snap" \
    -o -name node_modules -o -name .git \) -prune \
    -o -type l -print0 2>/dev/null || true
)
[ ${#links[@]} -gt 0 ] || exit 0

mapfile -d '' -t targets < <(readlink -zm -- "${links[@]}")

broken=""
for i in "${!links[@]}"; do
  [[ "${targets[i]}" == "$HOME/dotfiles/"* ]] || continue
  test -e "${links[i]}" || broken+="BROKEN: ${links[i]} -> ${targets[i]}"$'\n'
done

if [ "$broken" != "" ]; then
  printf '%s' "$broken"
  exit 1
fi
