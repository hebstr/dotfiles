#!/usr/bin/env bash
set -euo pipefail

broken=$(
  {
    find ~/ \
      \( -path "$HOME/.cache" -o -path "$HOME/.local/share" -o -path "$HOME/snap" \
      -o -path "$HOME/.mozilla" -o -name node_modules -o -name .git \) -prune \
      -o -type l -print 2>/dev/null || true
  } | while IFS= read -r link; do
    target=$(readlink -m "$link")
    [[ "$target" == "$HOME/dotfiles/"* ]] || continue
    test -e "$link" || printf 'BROKEN: %s -> %s\n' "$link" "$target"
  done
)

if [ "$broken" != "" ]; then
  printf '%s\n' "$broken"
  exit 1
fi
