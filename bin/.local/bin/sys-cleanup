#!/usr/bin/env bash
set -Eeuo pipefail

JOURNAL_SIZE="200M"
UV_ARCHIVE_MIN_AGE_MIN=1440
DRY_RUN=0
SELECTED_MODULES=()

ALL_MODULES=(
  trash
  uv
  rv
  prek
  npm
  r-cache
  claude-versions
  flatpak
  claude-cli
  chromium-headless
  positron-pycache
  workspace-storage
  jedi
  apt
  journal
  snap
)

SUDO_MODULES=(apt journal snap)

usage() {
  cat <<EOF
sys-cleanup: modular disk cleanup

Usage:
  sys-cleanup [options] [module...]

Options:
  --dry-run    print what would be removed, change nothing
  --list       list available modules
  -h, --help   show this help

Modules:
  $(printf '%s\n' "${ALL_MODULES[@]}" | paste -sd ' ')

With no module argument, all modules run.
EOF
}

list_modules() {
  printf '%-20s %s\n' MODULE SUDO
  for m in "${ALL_MODULES[@]}"; do
    local sudo_flag=no
    for s in "${SUDO_MODULES[@]}"; do
      [[ "$m" == "$s" ]] && sudo_flag=yes && break
    done
    printf '%-20s %s\n' "$m" "$sudo_flag"
  done
}

bytes_of() {
  { du -sb "$@" 2>/dev/null || true; } | awk '{sum+=$1} END{print sum+0}'
}

fs_used_bytes() {
  { df -B1 --output=source,used "$@" 2>/dev/null || true; } |
    awk 'NR>1 && !seen[$1]++ {sum+=$2} END{print sum+0}'
}

format_bytes() {
  local b="$1"
  if ((b >= 1073741824)); then
    awk "BEGIN{printf \"%.1f GiB\", $b/1073741824}"
  elif ((b >= 1048576)); then
    awk "BEGIN{printf \"%.0f MiB\", $b/1048576}"
  elif ((b >= 1024)); then
    awk "BEGIN{printf \"%.0f KiB\", $b/1024}"
  else
    echo "${b} B"
  fi
}

run_or_dry() {
  if ((DRY_RUN)); then
    printf '  [dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

RESULTS=()
TOTAL_FREED=0

record() {
  local module="$1" freed="$2" status="$3"
  ((freed < 0)) && freed=0
  RESULTS+=("$(printf '%-20s %-10s %s' "$module" "$(format_bytes "$freed")" "$status")")
  TOTAL_FREED=$((TOTAL_FREED + freed))
}

clean_trash() {
  local before
  before=$(bytes_of "${HOME}/.local/share/Trash")
  run_or_dry gio trash --empty
  local after
  after=$(bytes_of "${HOME}/.local/share/Trash")
  record trash $((before - after)) OK
}

sweep_uv_archive() {
  local archive="$1/archive-v0" entry
  [[ -d "$archive" ]] || return 0
  # Long-lived uv processes (MCP servers) always hold the cache lock; the age floor guards extracted-not-yet-linked entries.
  while IFS= read -r -d '' entry; do
    [[ -f "${entry}/pyvenv.cfg" ]] && continue
    [[ -n "$(find "$entry" -type f -links +1 -print -quit)" ]] && continue
    run_or_dry rm -rf "$entry"
  done < <(find "$archive" -mindepth 1 -maxdepth 1 -type d -mmin "+${UV_ARCHIVE_MIN_AGE_MIN}" -print0)
}

clean_uv() {
  if ! command -v uv >/dev/null 2>&1; then
    record uv 0 "skipped (not found)"
    return
  fi
  local before
  before=$(bytes_of "${HOME}/.cache/uv")
  sweep_uv_archive "${HOME}/.cache/uv"
  run_or_dry uv cache prune --force
  local after
  after=$(bytes_of "${HOME}/.cache/uv")
  record uv $((before - after)) OK
}

clean_rv() {
  local target="${HOME}/.cache/rv"
  [[ -d "$target" ]] || {
    record rv 0 "skipped (not found)"
    return
  }
  local before
  before=$(bytes_of "$target")
  # rv has no native cache GC. Cached packages are hardlinked into project
  # libraries, so a file with link count >1 is still live (deleting it frees no
  # disk and forces a re-download). Only link-count-1 entries (orphaned versions,
  # git clones, logs) are genuinely reclaimable; removing them never breaks a
  # project library.
  run_or_dry find "$target" -type f -links 1 -delete
  run_or_dry find "$target" -mindepth 1 -type d -empty -delete
  local after
  after=$(bytes_of "$target")
  record rv $((before - after)) OK
}

clean_prek() {
  if ! command -v prek >/dev/null 2>&1; then
    record prek 0 "skipped (not found)"
    return
  fi
  local before
  before=$(bytes_of "${HOME}/.cache/prek")
  run_or_dry prek cache gc
  sweep_uv_archive "${HOME}/.cache/prek/cache/uv"
  local after
  after=$(bytes_of "${HOME}/.cache/prek")
  record prek $((before - after)) OK
}

clean_npm() {
  if ! command -v npm >/dev/null 2>&1; then
    record npm 0 "skipped (not found)"
    return
  fi
  local before
  before=$(bytes_of "${HOME}/.npm/_cacache")
  run_or_dry npm cache verify
  local after
  after=$(bytes_of "${HOME}/.npm/_cacache")
  record npm $((before - after)) OK
}

clean_r_cache() {
  local before=0 after=0
  if command -v Rscript >/dev/null 2>&1; then
    before=$(bytes_of "${HOME}/.cache/R/pkgcache")
    run_or_dry Rscript -e 'pak::cache_clean()'
    local meta="${HOME}/.cache/R/pkgcache/_metadata" current snapshot
    current=$(Rscript -e 'cat(pak::meta_summary()[["current_db"]])' 2>/dev/null || true)
    if [[ -f "$current" && "${current%/*}" == "$meta" ]]; then
      for snapshot in "$meta"/pkgs-*.rds; do
        [[ -f "$snapshot" && "$snapshot" != "$current" ]] || continue
        run_or_dry rm -f "$snapshot"
      done
    fi
    after=$(bytes_of "${HOME}/.cache/R/pkgcache")
  fi
  local sass="${HOME}/.cache/R/sass"
  local sass_before=0 sass_after=0
  if [[ -d "$sass" ]]; then
    sass_before=$(bytes_of "$sass")
    run_or_dry rm -rf "$sass"
    sass_after=$(bytes_of "$sass")
  fi
  record r-cache $(((before - after) + (sass_before - sass_after))) OK
}

clean_claude_versions() {
  local versions_dir="${HOME}/.local/share/claude/versions"
  [[ -d "$versions_dir" ]] || {
    record claude-versions 0 "skipped (not found)"
    return
  }
  local latest
  latest=$(find "$versions_dir" -mindepth 1 -maxdepth 1 \( -type d -o -type f \) -printf '%f\n' |
    { grep -E '^[0-9]+(\.[0-9]+)*$' || true; } | sort -V | tail -n1)
  if [[ -z "$latest" ]]; then
    record claude-versions 0 "skipped (no version entry)"
    return
  fi
  local in_use=""
  in_use=$(readlink -f "${HOME}/.local/bin/claude" 2>/dev/null || true)
  [[ "${in_use%/*}" == "$versions_dir" ]] && in_use="${in_use##*/}" || in_use=""
  local before
  before=$(bytes_of "$versions_dir")
  while IFS= read -r ver; do
    [[ "$ver" == "$latest" || "$ver" == "$in_use" ]] && continue
    run_or_dry rm -rf "${versions_dir:?}/${ver}"
  done < <(find "$versions_dir" -mindepth 1 -maxdepth 1 \( -type d -o -type f \) -printf '%f\n' |
    { grep -E '^[0-9]+(\.[0-9]+)*$' || true; })
  local after
  after=$(bytes_of "$versions_dir")
  record claude-versions $((before - after)) OK
}

clean_flatpak() {
  if ! command -v flatpak >/dev/null 2>&1; then
    record flatpak 0 "skipped (not found)"
    return
  fi
  local paths=("${HOME}/.local/share/flatpak" /var/lib/flatpak)
  local before
  before=$(bytes_of "${paths[@]}")
  run_or_dry flatpak uninstall --unused -y
  local after
  after=$(bytes_of "${paths[@]}")
  record flatpak $((before - after)) OK
}

clean_claude_cli() {
  local target="${HOME}/.cache/claude-cli-nodejs"
  [[ -d "$target" ]] || {
    record claude-cli 0 "skipped (not found)"
    return
  }
  local before
  before=$(bytes_of "$target")
  run_or_dry rm -rf "$target"
  local after
  after=$(bytes_of "$target")
  record claude-cli $((before - after)) OK
}

clean_chromium_headless() {
  local common="${HOME}/snap/chromium/common"
  [[ -d "$common" ]] || {
    record chromium-headless 0 "skipped (not found)"
    return
  }
  local before
  before=$(bytes_of "$common")
  local dir lock pid
  for dir in "$common"/chromium-headless/scoped_dir* "$common"/claude-profile.*; do
    # A killed run leaves SingletonLock -> "<host>-<pid>" on a dead pid; a live pid or no lock means possibly in use.
    [[ -d "$dir" && -L "${dir}/SingletonLock" ]] || continue
    lock=$(readlink "${dir}/SingletonLock")
    pid="${lock##*-}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    [[ -e "/proc/${pid}" ]] && continue
    run_or_dry rm -rf "$dir"
  done
  local after
  after=$(bytes_of "$common")
  record chromium-headless $((before - after)) OK
}

clean_positron_pycache() {
  local prefix="${HOME}/.config/Positron/User/globalStorage/ms-python.python/pycache"
  [[ -d "$prefix" ]] || {
    record positron-pycache 0 "skipped (not found)"
    return
  }
  local before
  before=$(bytes_of "$prefix")
  local mirrors=() mirror src
  mapfile -d '' mirrors < <(find "$prefix" -mindepth 1 -type d -print0)
  for mirror in "${mirrors[@]}"; do
    src="${mirror#"$prefix"}"
    [[ ! -d "$src" && -d "${src%/*}" ]] || continue
    run_or_dry rm -rf "$mirror"
  done
  local after
  after=$(bytes_of "$prefix")
  record positron-pycache $((before - after)) OK
}

clean_workspace_storage() {
  local roots=() root
  for root in "${HOME}/.config/Positron/User/workspaceStorage" "${HOME}/.config/Code/User/workspaceStorage"; do
    [[ -d "$root" ]] && roots+=("$root")
  done
  ((${#roots[@]} > 0)) || {
    record workspace-storage 0 "skipped (not found)"
    return
  }
  local before
  before=$(bytes_of "${roots[@]}")
  local pattern='"folder"[[:space:]]*:[[:space:]]*"file://([^"]*)"'
  local entry json encoded folder
  for root in "${roots[@]}"; do
    for entry in "$root"/*/; do
      entry="${entry%/}"
      [[ -f "${entry}/workspace.json" ]] || continue
      json=$(<"${entry}/workspace.json")
      [[ "$json" =~ $pattern ]] || continue
      encoded="${BASH_REMATCH[1]}"
      [[ "$encoded" == /* && "$encoded" != *\\* ]] || continue
      printf -v folder '%b' "${encoded//%/\\x}"
      [[ -d "$folder" ]] && continue
      run_or_dry rm -rf "$entry"
    done
  done
  local after
  after=$(bytes_of "${roots[@]}")
  record workspace-storage $((before - after)) OK
}

clean_jedi() {
  local before=0 after=0
  for target in "${HOME}/.cache/positron-jedi" "${HOME}/.cache/jedi"; do
    [[ -d "$target" ]] || continue
    before=$((before + $(bytes_of "$target")))
    run_or_dry rm -rf "$target"
    after=$((after + $(bytes_of "$target")))
  done
  record jedi $((before - after)) OK
}

clean_apt() {
  local before
  before=$(fs_used_bytes /usr /var /boot)
  local rc_count=0
  local rc_pkgs=()
  mapfile -t rc_pkgs < <(dpkg -l | awk '/^rc/ {print $2}')
  if [[ ${#rc_pkgs[@]} -gt 0 ]]; then
    rc_count=${#rc_pkgs[@]}
    run_or_dry sudo dpkg --purge "${rc_pkgs[@]}"
  fi
  run_or_dry sudo apt-get clean -y
  run_or_dry sudo apt-get autoremove --purge -y
  local after
  after=$(fs_used_bytes /usr /var /boot)
  record apt $((before - after)) "OK (${rc_count} rc purged)"
}

clean_journal() {
  local before
  before=$(bytes_of /var/log/journal)
  run_or_dry sudo journalctl "--vacuum-size=${JOURNAL_SIZE}"
  local after
  after=$(bytes_of /var/log/journal)
  record journal $((before - after)) OK
}

clean_snap() {
  if ! command -v snap >/dev/null 2>&1; then
    record snap 0 "skipped (not found)"
    return
  fi
  local before
  before=$(bytes_of /var/lib/snapd/snaps)
  if ((DRY_RUN)); then
    LANG=C snap list --all | awk '/disabled/{print "  [dry-run] snap remove "$1" --revision="$3}'
  else
    LANG=C snap list --all | awk '/disabled/{print $1, $3}' |
      while read -r name rev; do
        sudo snap remove "$name" --revision="$rev"
      done
  fi
  local after
  after=$(bytes_of /var/lib/snapd/snaps)
  record snap $((before - after)) OK
}

needs_sudo() {
  local modules=("$@")
  for m in "${modules[@]}"; do
    for s in "${SUDO_MODULES[@]}"; do
      [[ "$m" == "$s" ]] && return 0
    done
  done
  return 1
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      usage
      return 0
      ;;
    --list)
      list_modules
      return 0
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -*)
      printf 'sys-cleanup: unknown option: %s\n' "$1" >&2
      return 2
      ;;
    *)
      SELECTED_MODULES+=("$1")
      shift
      ;;
    esac
  done

  if [[ ${#SELECTED_MODULES[@]} -eq 0 ]]; then
    SELECTED_MODULES=("${ALL_MODULES[@]}")
  fi

  for m in "${SELECTED_MODULES[@]}"; do
    local found=0
    for known in "${ALL_MODULES[@]}"; do
      [[ "$m" == "$known" ]] && found=1 && break
    done
    if ((found == 0)); then
      printf 'sys-cleanup: unknown module: %s\n' "$m" >&2
      return 2
    fi
  done

  if ! ((DRY_RUN)) && needs_sudo "${SELECTED_MODULES[@]}"; then
    sudo -v
  fi

  for m in "${SELECTED_MODULES[@]}"; do
    printf '→ %s\n' "$m"
    "clean_${m//-/_}"
  done

  printf '\n%-20s %-10s %s\n' MODULE FREED STATUS
  printf '%s\n' "$(printf '%.0s-' {1..40})"
  for line in "${RESULTS[@]}"; do
    printf '%s\n' "$line"
  done
  printf '%s\n' "$(printf '%.0s-' {1..40})"
  printf '%-20s %s\n' TOTAL "$(format_bytes "$TOTAL_FREED")"

  local orphans
  if command -v sys-orphans >/dev/null 2>&1; then
    orphans=$(sys-orphans --count 2>/dev/null || true)
    if [[ "$orphans" =~ ^[0-9]+$ ]] && ((orphans > 0)); then
      printf '\n%s orphans found, run sys-orphans for details\n' "$orphans"
    fi
  fi
}

main "$@"
