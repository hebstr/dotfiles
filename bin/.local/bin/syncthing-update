#!/usr/bin/env bash
set -euo pipefail

command -v curl >/dev/null 2>&1 || {
  printf 'curl is required\n' >&2
  exit 1
}

KEY_URL="${KEY_URL:-https://syncthing.net/release-key.gpg}"
KEYRING="${KEYRING:-/etc/apt/keyrings/syncthing-archive-keyring.gpg}"
SOURCES_LIST="${SOURCES_LIST:-/etc/apt/sources.list.d/syncthing.list}"
PREFS_FILE="${PREFS_FILE:-/etc/apt/preferences.d/syncthing.pref}"
CHANNEL="${CHANNEL:-stable-v2}"

sudo -v

if [ ! -s "${KEYRING}" ]; then
  echo "Installing Syncthing GPG key to ${KEYRING}..."
  sudo install -d -m 0755 /etc/apt/keyrings
  curl -fsSL "${KEY_URL}" | sudo install -m 0644 -o root -g root /dev/stdin "${KEYRING}"
fi

if [ ! -s "${SOURCES_LIST}" ]; then
  echo "Adding apt.syncthing.net (${CHANNEL}) to ${SOURCES_LIST}..."
  echo "deb [signed-by=${KEYRING}] https://apt.syncthing.net/ syncthing ${CHANNEL}" |
    sudo install -m 0644 -o root -g root /dev/stdin "${SOURCES_LIST}"
fi

if [ ! -s "${PREFS_FILE}" ]; then
  echo "Pinning apt.syncthing.net over Ubuntu repo at ${PREFS_FILE}..."
  printf 'Package: *\nPin: origin apt.syncthing.net\nPin-Priority: 990\n' |
    sudo install -m 0644 -o root -g root /dev/stdin "${PREFS_FILE}"
fi

echo "Refreshing apt..."
sudo apt-get update

echo "Installing/upgrading syncthing..."
sudo apt-get install -y syncthing

echo
syncthing --version
