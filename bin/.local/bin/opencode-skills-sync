#!/usr/bin/env bash
set -Eeuo pipefail

command -v jq >/dev/null 2>&1 || {
  printf 'jq is required\n' >&2
  exit 1
}

INSTALLED="${HOME}/.claude/plugins/installed_plugins.json"
SETTINGS="${HOME}/.claude/settings.json"
FARM="${XDG_DATA_HOME:-${HOME}/.local/share}/opencode-claude-skills"

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

for f in "$INSTALLED" "$SETTINGS"; do
  [ -f "$f" ] || die "${f} not found: cannot tell which plugin skills are enabled"
done

# Claude Code's plugin files are internal and undocumented, so any drift in
# their shape stops the sync instead of yielding an empty skill set.
if ! PLUGINS=$(jq -r '
  if (.plugins | type) != "object" then error("no .plugins object") else
    .plugins | to_entries[] |
    if (.value | type) != "array" or (.value | length) == 0 or (.value[0].installPath | type) != "string"
    then error("no installPath for \(.key)")
    else "\(.key)\t\(.value[0].installPath)" end
  end' "$INSTALLED" 2>&1); then
  die "Unexpected shape of ${INSTALLED}: ${PLUGINS}"
fi

if ! ENABLED=$(jq -r '
  if (.enabledPlugins | type) != "object" then error("no .enabledPlugins object")
  else .enabledPlugins | to_entries[] | select(.value == true) | .key end' "$SETTINGS" 2>&1); then
  die "Unexpected shape of ${SETTINGS}: ${ENABLED}"
fi

# Prints one skill directory per line for plugin $1 installed at $2. An entry
# of the marketplace manifest carrying a skills array names them exactly, and
# is the only record of ownership when several plugins share one repository;
# otherwise the plugin's skills/ directory and any plugin.json skills paths.
skill_dirs() {
  local name="$1" root="$2" market="$2/.claude-plugin/marketplace.json"
  local manifest="$2/.claude-plugin/plugin.json" listed="" extra="" d
  if [ -f "$market" ]; then
    listed=$(jq -r --arg n "$name" \
      '[.plugins[]? | select(.name == $n) | .skills // empty | if type == "array" then .[] else . end] | .[]' \
      "$market") || die "Cannot read ${market}"
  fi
  if [ "$listed" != "" ]; then
    while IFS= read -r d; do
      printf '%s\n' "${root}/${d#./}"
    done <<<"$listed"
    return
  fi
  if [ -f "$manifest" ]; then
    extra=$(jq -r '.skills // empty | if type == "array" then .[] else . end' "$manifest") ||
      die "Cannot read ${manifest}"
  fi
  {
    printf '%s\n' "${root}/skills"
    [ "$extra" = "" ] || while IFS= read -r d; do
      printf '%s\n' "${root}/${d#./}"
    done <<<"$extra"
  } | while IFS= read -r base; do
    base="${base%/}"
    [ -d "$base" ] || continue
    for d in "$base"/*/; do
      if [ -f "${d}SKILL.md" ]; then
        printf '%s\n' "${d%/}"
      fi
    done
  done | sort -u
}

STAGE=$(mktemp -d "${FARM}.new.XXXXXX" 2>/dev/null) || {
  mkdir -p "$(dirname "$FARM")"
  STAGE=$(mktemp -d "${FARM}.new.XXXXXX")
}
trap 'rm -rf "$STAGE"' EXIT

TOTAL=0
while IFS=$'\t' read -r key root; do
  [ "$key" != "" ] || continue
  grep -qxF -- "$key" <<<"$ENABLED" || continue
  name="${key%@*}"
  [ -d "$root" ] || die "${key}: install path ${root} is missing"
  dirs=$(skill_dirs "$name" "$root")
  count=0
  if [ "$dirs" != "" ]; then
    while IFS= read -r d; do
      [ -f "${d}/SKILL.md" ] || die "${key}: ${d} has no SKILL.md"
      link="${STAGE}/${name}/$(basename "$d")"
      [ -e "$link" ] && die "${key}: $(basename "$d") collides with $(readlink "$link")"
      mkdir -p "${STAGE}/${name}"
      ln -s "$d" "$link"
      count=$((count + 1))
    done <<<"$dirs"
  fi
  [ "$count" -eq 0 ] || printf '  %s: %d skill(s)\n' "$key" "$count"
  TOTAL=$((TOTAL + count))
done <<<"$PLUGINS"

# The previous farm is replaced only once the new one is complete, so a
# failure above leaves opencode with the last good set.
OLD=""
if [ -e "$FARM" ]; then
  OLD="${FARM}.old.$$"
  mv "$FARM" "$OLD"
fi
mv "$STAGE" "$FARM"
[ "$OLD" = "" ] || rm -rf "$OLD"

printf 'Linked %d plugin skill(s) into %s\n' "$TOTAL" "$FARM"
