#!/usr/bin/env bash
set -euo pipefail

if command -v rv > /dev/null 2>&1; then
  echo "$(rv --version) already installed." >&2
  exit 0
fi

echo "rv not found in PATH — bootstrapping from A2-ai's official installer…" >&2
curl -fsSL \
  --connect-timeout 10 \
  --max-time 120 \
  --retry 2 \
  https://raw.githubusercontent.com/A2-ai/rv/refs/heads/main/scripts/install.sh |
  bash

if ! command -v rv > /dev/null 2>&1; then
  echo "rv installed but not yet on PATH in this shell." >&2
  echo "Open a new terminal or re-source your shell rc, then re-run." >&2
  exit 1
fi

echo "$(rv --version) installed." >&2
