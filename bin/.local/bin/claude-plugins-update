#!/usr/bin/env bash
set -euo pipefail

command -v jq >/dev/null 2>&1 || {
  printf 'jq is required\n' >&2
  exit 1
}
command -v claude >/dev/null 2>&1 || {
  printf 'claude is required\n' >&2
  exit 1
}
INSTALLED=~/.claude/plugins/installed_plugins.json
FAILED=0

# An unreachable marketplace must not block the plugin updates that follow, but
# still has to surface as a non-zero exit for the sys-update status table.
claude plugin marketplace update || FAILED=1

if [ ! -f "$INSTALLED" ]; then
  echo "No installed_plugins.json found: nothing else to update."
  exit "$FAILED"
fi

echo "Updating installed plugins..."

# Command substitution, not a process substitution: the latter discards jq's
# exit status, so an unreadable or malformed file would update nothing and
# still report success. No -e either, since an empty .plugins is not an error.
if ! PLUGINS=$(jq -r '.plugins | keys[]' "$INSTALLED"); then
  echo "Could not read the plugin list from ${INSTALLED}" >&2
  FAILED=1
elif [ "$PLUGINS" != "" ]; then
  while IFS= read -r plugin; do
    echo "  → ${plugin}"
    # No -y: a changed marketplace-declared command must reach a person, so
    # such a plugin fails here until it is updated by hand.
    claude plugin update "$plugin" </dev/null || {
      echo "    [failed]" >&2
      FAILED=1
    }
  done <<<"$PLUGINS"
fi

# opencode reaches plugin skills through links pinned to install paths, which
# the updates above may have moved.
if command -v opencode >/dev/null 2>&1 && command -v opencode-skills-sync >/dev/null 2>&1; then
  echo "Resyncing plugin skills for opencode..."
  opencode-skills-sync || FAILED=1
fi

exit "$FAILED"
