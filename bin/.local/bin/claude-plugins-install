#!/usr/bin/env bash
# Declarative restore of Claude Code marketplaces, plugins, and autoUpdate flags.
# Reads desired state from ~/.claude/settings.json (extraKnownMarketplaces + enabledPlugins).
#
# Run on a fresh machine (or after a wipe) to rebuild the plugin setup:
#   claude-plugins-install
#
# Idempotent: re-running only adds what's missing. Existing installs are left alone.

set -euo pipefail

log() { printf '\033[1;34m[plugins]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[plugins]\033[0m %s\n' "$*" >&2; }

if ! command -v claude >/dev/null 2>&1; then
  warn "claude CLI not found in PATH. Install Claude Code first."
  exit 1
fi
command -v jq >/dev/null 2>&1 || {
  printf 'jq is required\n' >&2
  exit 1
}

SETTINGS="$HOME/.claude/settings.json"
if [ ! -f "$SETTINGS" ]; then
  warn "settings.json not found at $SETTINGS"
  exit 1
fi

FAILED=0

# ---------------------------------------------------------------------------
# 1. Marketplaces (from settings.json extraKnownMarketplaces)
# ---------------------------------------------------------------------------
# Command substitution, not a process substitution: the latter discards jq's
# exit status, so an unreadable settings.json would restore nothing and still
# report success. An unusable marketplace section must not block the plugins
# that follow, but still has to surface as a non-zero exit.
log "Adding marketplaces..."
if ! SOURCES=$(jq -r '.extraKnownMarketplaces // {} | to_entries[] | .value.source | (.repo // .path // empty)' "$SETTINGS"); then
  warn "  could not read the marketplace list from $SETTINGS"
  FAILED=1
elif [ "$SOURCES" != "" ]; then
  while IFS= read -r src; do
    [ "$src" = "" ] && continue
    log "  marketplace add $src"
    claude plugin marketplace add "$src" </dev/null || warn "    (already present or failed: $src)"
  done <<<"$SOURCES"
fi

# ---------------------------------------------------------------------------
# 2. Plugins (from settings.json enabledPlugins where value == true)
# ---------------------------------------------------------------------------
log "Installing plugins..."
if ! PLUGINS=$(jq -r '.enabledPlugins // {} | to_entries[] | select(.value == true) | .key' "$SETTINGS"); then
  warn "  could not read the plugin list from $SETTINGS"
  FAILED=1
elif [ "$PLUGINS" != "" ]; then
  while IFS= read -r plugin; do
    [ "$plugin" = "" ] && continue
    log "  plugin install $plugin"
    claude plugin install "$plugin" </dev/null || warn "    (already installed or failed: $plugin)"
  done <<<"$PLUGINS"
fi

# ---------------------------------------------------------------------------
# 3. Antigravity skills (not available as individual plugins)
# Pinned to a commit SHA: bump deliberately after reviewing upstream diff.
# Upstream is trusted-on-pin, not trusted-on-HEAD.
# ---------------------------------------------------------------------------
# ANTIGRAVITY_REF="45bad85d0d4cff01426074756d14d429a60b8cca"
# ANTIGRAVITY_SKILLS=(
#   "bats-testing-patterns"
#   "bash-defensive-patterns"
# )

# fetch_skill_file() {
#   local repo_path="$1" dest="$2" tmp
#   tmp=$(mktemp)
#   if gh api "${repo_path}?ref=${ANTIGRAVITY_REF}" \
#     --jq 'if .content then .content else error("no .content field") end' \
#     2>/dev/null | base64 -d >"$tmp" &&
#     [ "$(wc -c <"$tmp")" -gt 100 ]; then
#     mv "$tmp" "$dest"
#     return 0
#   else
#     rm -f "$tmp"
#     return 1
#   fi
# }

# if ! command -v gh >/dev/null 2>&1; then
#   warn "gh CLI not found: skipping antigravity skills update"
# else
#   log "Updating antigravity skills (pinned: ${ANTIGRAVITY_REF:0:7})..."
#   for skill in "${ANTIGRAVITY_SKILLS[@]}"; do
#     mkdir -p ~/.claude/skills/"$skill"/resources
#     fetch_skill_file \
#       "repos/sickn33/antigravity-awesome-skills/contents/skills/${skill}/SKILL.md" \
#       ~/.claude/skills/"$skill"/SKILL.md ||
#       warn "    failed to fetch ${skill}/SKILL.md: keeping existing file"
#     fetch_skill_file \
#       "repos/sickn33/antigravity-awesome-skills/contents/skills/${skill}/resources/implementation-playbook.md" \
#       ~/.claude/skills/"$skill"/resources/implementation-playbook.md ||
#       warn "    failed to fetch ${skill}/resources/implementation-playbook.md: keeping existing file"
#     log "  updated: ${skill}"
#   done
# fi

# ---------------------------------------------------------------------------
# 4. Enable autoUpdate on every installed plugin
# ---------------------------------------------------------------------------
REG="$HOME/.claude/plugins/installed_plugins.json"

if [ -f "$REG" ]; then
  log "Enabling autoUpdate on all installed plugins..."
  BACKUP="$REG.bak.$(date +%Y%m%d-%H%M%S)"
  cp "$REG" "$BACKUP"
  TMP=$(mktemp)
  jq '.plugins |= map_values(map(. + {autoUpdate: true}))' "$REG" >"$TMP"
  mv "$TMP" "$REG"
  log "  registry patched. backup: $BACKUP"
else
  warn "installed_plugins.json not found at $REG -- skipping autoUpdate patch"
fi

if [ "$FAILED" -ne 0 ]; then
  warn "Finished with errors: the restore is incomplete (see warnings above)."
  exit "$FAILED"
fi

log "Done. Restart Claude Code for plugin changes to take effect."
