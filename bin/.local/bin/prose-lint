#!/usr/bin/env bash
# prose-lint: mechanical anti-AI-slop checks for .md / .qmd files.
#
# Rules from ~/.claude/CLAUDE.md (Prose hygiene + Communication sections):
#   - no em dashes in prose (rhetorical use); typographic em dashes in
#     markdown table cells and markdown headers are exempt
#   - en dashes flagged outside numeric ranges (token–token between
#     alphanumerics is exempt: 2–4, v2.1–v2.2, 5–15 %, pages 12–18)
#   - table rows (lines starting with |) and markdown headers (lines
#     starting with #) are exempt from em/en dash checks: em/en dashes
#     in those contexts are typographic separators, not rhetorical prose
#
# Semantic checks (ritual openers, rhetorical self-questions, negative
# parallelism) are context-dependent and noisy to verify mechanically;
# defer to /write.
#
# Skips triple-backtick fenced blocks, `$$…$$` display-math blocks, inline
# backtick spans, and any line containing the marker
# `<!-- prose-lint:ignore -->` (use the marker for rule-meta lines that
# document a forbidden pattern verbatim). Tilde fences (~~~) and 4-space
# indented code blocks are NOT recognized.
#
# Files under any `.claude/memory/` path are skipped entirely: memory files
# are Claude-facing instructions, not user-facing prose, so the rhetorical
# dash rules do not apply. Other `.claude/` files (CLAUDE.md, rules/) are
# still checked.
#
# Working/backlog files are skipped by basename (case-sensitive, any depth):
# PLAN.md, DEFERRED.md, CONTEXT.md, MEMORY.md (Claude operational state),
# TODO.md and CALENDRIER.md (the user's own scratchpads, which Claude may read
# but never write). Case-sensitivity matters: `CONTEXT.md` is skipped but
# `context.md` (skill documentation) is still checked.

set -Eeuo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: prose-lint <file> [<file>...]" >&2
  exit 2
fi

violations=0

strip_code() {
  awk '
    /^```/ { fence = !fence; print NR "\t"; next }
    fence  { print NR "\t"; next }
    /^\$\$.*\$\$/ { print NR "\t"; next }
    /^\$\$/ { math = !math; print NR "\t"; next }
    math   { print NR "\t"; next }
    /<!-- prose-lint:ignore -->/ { print NR "\t"; next }
    {
      gsub(/`[^`]*`/, "")
      print NR "\t" $0
    }
  ' "$1"
}

flag() {
  printf '%s:%s: [%s] %s\n' "$1" "$2" "$3" "$4"
  violations=$((violations + 1))
}

is_typographic_context() {
  printf '%s' "$1" | grep -qE '^[ \t]*(\||#)'
}

check_em_dash() {
  local file=$1 lineno content
  while IFS=$'\t' read -r lineno content; do
    [ "$content" = "" ] && continue
    is_typographic_context "$content" && continue
    if printf '%s' "$content" | grep -q '—'; then
      flag "$file" "$lineno" "em-dash" "em dash in prose (CLAUDE.md: Prose hygiene)"
    fi
  done < <(strip_code "$file")
}

check_en_dash() {
  local file=$1 lineno content stripped
  while IFS=$'\t' read -r lineno content; do
    [ "$content" = "" ] && continue
    is_typographic_context "$content" && continue
    stripped=$(printf '%s' "$content" | sed -E 's/[A-Za-z0-9.]+–[A-Za-z0-9.]+//g')
    if printf '%s' "$stripped" | grep -q '–'; then
      flag "$file" "$lineno" "en-dash" "en dash in prose (CLAUDE.md: Prose hygiene)"
    fi
  done < <(strip_code "$file")
}

for f in "$@"; do
  if [ ! -f "$f" ]; then
    echo "prose-lint: not a file: $f" >&2
    exit 2
  fi
  case "$f" in
  */.claude/memory/* | .claude/memory/*)
    echo "prose-lint: skipping (.claude/memory is Claude-facing, not user prose): $f" >&2
    continue
    ;;
  esac
  case "${f##*/}" in
  PLAN.md | DEFERRED.md | CONTEXT.md | MEMORY.md | TODO.md | CALENDRIER.md)
    echo "prose-lint: skipping (working/backlog file, exempt from prose hygiene): $f" >&2
    continue
    ;;
  esac
  case "$f" in
  *.md | *.qmd) ;;
  *)
    echo "prose-lint: skipping (not .md/.qmd): $f" >&2
    continue
    ;;
  esac
  check_em_dash "$f"
  check_en_dash "$f"
done

if [ "$violations" -gt 0 ]; then
  printf '\nprose-lint: %d violation(s) found\n' "$violations" >&2
  exit 1
fi

exit 0
