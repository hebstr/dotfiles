{"name":"hebstr-positron","icon":"smiley","settings":"{\"settings\":\"{\\n  // ÉDITEUR ---------------------------------------------------------------------\\n\\n  \\\"editor.fontFamily\\\": \\\"'Fira Code', 'monospace'\\\",\\n  \\\"editor.fontSize\\\": 12,\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.lineHeight\\\": 1.5,\\n  \\\"editor.detectIndentation\\\": true,\\n  \\\"editor.tabSize\\\": 4,\\n  \\\"editor.tabCompletion\\\": \\\"on\\\",\\n  \\\"editor.formatOnSave\\\": false,\\n  \\\"editor.formatOnPaste\\\": false,\\n  \\\"editor.renderFinalNewline\\\": \\\"dimmed\\\",\\n  \\\"editor.actionBar.enabled\\\": false,\\n  \\\"editor.cursorBlinking\\\": \\\"phase\\\",\\n  \\\"editor.cursorStyle\\\": \\\"line\\\",\\n  \\\"editor.cursorWidth\\\": 3,\\n  \\\"editor.cursorSurroundingLines\\\": 10,\\n  \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n  \\\"notebook.lineNumbers\\\": \\\"on\\\",\\n\\n  \\\"editor.rulers\\\": [\\n    {\\n      \\\"column\\\": 80,\\n    },\\n    {\\n      \\\"color\\\": \\\"#ff0000\\\",\\n      \\\"column\\\": 100,\\n    },\\n  ],\\n\\n  // TERMINAL --------------------------------------------------------------------\\n\\n  \\\"terminal.integrated.fontFamily\\\": \\\"'Fira Code', 'monospace'\\\",\\n  \\\"terminal.integrated.fontSize\\\": 12,\\n  \\\"terminal.integrated.fontLigatures.enabled\\\": true,\\n  \\\"terminal.integrated.cursorBlinking\\\": true,\\n  \\\"terminal.integrated.cursorStyle\\\": \\\"line\\\",\\n  \\\"terminal.integrated.cursorWidth\\\": 3,\\n  \\\"terminal.integrated.cursorStyleInactive\\\": \\\"line\\\",\\n  \\\"terminal.integrated.stickyScroll.enabled\\\": false,\\n  \\\"terminal.integrated.environmentChangesRelaunch\\\": true,\\n  \\\"terminal.integrated.gpuAcceleration\\\": \\\"off\\\",\\n\\n  // GESTION DES FICHIERS --------------------------------------------------------\\n\\n  \\\"files.defaultLanguage\\\": \\\"r\\\",\\n  \\\"files.insertFinalNewline\\\": true,\\n  \\\"files.trimFinalNewlines\\\": true,\\n  \\\"files.trimTrailingWhitespace\\\": true,\\n  \\\"files.associations\\\": {\\n    \\\"renv.lock\\\": \\\"json\\\",\\n    \\\"**/SKILL.md\\\": \\\"markdown\\\",\\n    \\\".stignore\\\": \\\"ignore\\\",\\n    \\\"**/dotfiles/bin/.local/bin/*\\\": \\\"shellscript\\\",\\n  },\\n\\n  // EXCLUSIONS DE FICHIERS ------------------------------------------------------\\n\\n  \\\"files.exclude\\\": {\\n    \\\"**/.Rhistory\\\": true,\\n    \\\"**/*.Rproj\\\": true,\\n    \\\"**/.Rproj.user\\\": true,\\n    \\\"**/renv/library\\\": true,\\n    \\\"**/renv/local\\\": true,\\n    \\\"**/renv/sandbox\\\": true,\\n    \\\"**/renv/staging\\\": true,\\n    \\\"**/.quarto\\\": true,\\n    \\\"**/_book\\\": true,\\n    \\\"**/_site\\\": true,\\n    \\\"**/_freeze\\\": true,\\n    \\\"**/.venv\\\": true,\\n    \\\"**/.ruff_cache\\\": true,\\n  },\\n\\n  \\\"files.watcherExclude\\\": {\\n    \\\"**/.Rhistory\\\": true,\\n    \\\"**/.Rproj.user\\\": true,\\n    \\\"**/renv/library\\\": true,\\n    \\\"**/renv/local\\\": true,\\n    \\\"**/renv/sandbox\\\": true,\\n    \\\"**/renv/staging\\\": true,\\n    \\\"**/.quarto\\\": true,\\n    \\\"**/_book\\\": true,\\n    \\\"**/_site\\\": true,\\n    \\\"**/_freeze\\\": true,\\n    \\\"**/.venv\\\": true,\\n    \\\"**/.ruff_cache\\\": true,\\n  },\\n\\n  \\\"search.exclude\\\": {\\n    \\\"**/.Rhistory\\\": true,\\n    \\\"**/.Rproj.user\\\": true,\\n    \\\"**/renv/library\\\": true,\\n    \\\"**/renv/local\\\": true,\\n    \\\"**/renv/sandbox\\\": true,\\n    \\\"**/renv/staging\\\": true,\\n    \\\"**/.quarto\\\": true,\\n    \\\"**/_book\\\": true,\\n    \\\"**/_site\\\": true,\\n    \\\"**/_freeze\\\": true,\\n    \\\"**/.venv\\\": true,\\n    \\\"**/.ruff_cache\\\": true,\\n  },\\n\\n  \\\"search.quickOpen.includeSymbols\\\": true,\\n\\n  // LANGAGE SPÉCIFIQUE ----------------------------------------------------------\\n\\n  \\\"[r]\\\": {\\n    \\\"editor.tabSize\\\": 2,\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"Posit.air-vscode\\\",\\n  },\\n\\n  \\\"[python]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"charliermarsh.ruff\\\",\\n  },\\n\\n  \\\"[rust]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"rust-lang.rust-analyzer\\\",\\n  },\\n\\n  \\\"[markdown]\\\": {\\n    \\\"files.trimTrailingWhitespace\\\": false,\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"jolars.panache\\\",\\n  },\\n\\n  \\\"[quarto]\\\": {\\n    \\\"files.trimTrailingWhitespace\\\": false,\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"jolars.panache\\\",\\n  },\\n\\n  \\\"quarto.render.previewType\\\": \\\"external\\\",\\n\\n  \\\"panache.executableStrategy\\\": \\\"environment\\\",\\n\\n  \\\"air.executableStrategy\\\": \\\"environment\\\",\\n  \\\"python.installModulesInTerminal\\\": true,\\n  \\\"python.globalModuleInstallation\\\": false,\\n  \\\"python.enableAutoReload\\\": false,\\n  \\\"python.terminal.activateEnvironment\\\": true,\\n  \\\"python.pyrefly.typeCheckingMode\\\": \\\"default\\\",\\n\\n  \\\"[dockerfile]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\",\\n  },\\n\\n  \\\"[shellscript]\\\": {\\n    \\\"editor.tabSize\\\": 2,\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"mads-hartmann.bash-ide-vscode\\\",\\n  },\\n  \\\"bashIde.shellcheckPath\\\": \\\"shellcheck\\\",\\n  \\\"bashIde.shfmt.path\\\": \\\"/usr/bin/shfmt\\\",\\n  \\\"bashIde.enableSourceErrorDiagnostics\\\": true,\\n  \\\"bashIde.shfmt.caseIndent\\\": false,\\n  \\\"bashIde.shfmt.spaceRedirects\\\": false,\\n\\n  \\\"[typst]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"myriad-dreamin.tinymist\\\",\\n  },\\n  \\\"tinymist.formatterMode\\\": \\\"typstyle\\\",\\n  \\\"tinymist.lint.enabled\\\": true,\\n  \\\"tinymist.formatterPrintWidth\\\": 100,\\n\\n  \\\"[lua]\\\": {\\n    \\\"editor.tabSize\\\": 2,\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"JohnnyMorganz.stylua\\\",\\n  },\\n  \\\"Lua.format.enable\\\": false,\\n\\n  \\\"[css]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  },\\n\\n  \\\"[scss]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  },\\n  \\\"somesass.scss.completion.suggestFromUseOnly\\\": true,\\n  \\\"somesass.sass.completion.suggestFromUseOnly\\\": true,\\n\\n  \\\"[sql]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"sqlfluff.vscode-sqlfluff\\\",\\n  },\\n  \\\"sqlfluff.executablePath\\\": \\\"/home/julien/.local/bin/sqlfluff\\\",\\n  \\\"sqlfluff.linter.run\\\": \\\"onSave\\\",\\n\\n  \\\"[json]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  },\\n\\n  \\\"[jsonc]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  },\\n\\n  \\\"[jsonl]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  },\\n\\n  \\\"[javascript]\\\": {\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  },\\n\\n  // GIT -------------------------------------------------------------------------\\n\\n  \\\"git.openRepositoryInParentFolders\\\": \\\"always\\\",\\n  \\\"git.autoRepositoryDetection\\\": false,\\n  \\\"git.enableCommitSigning\\\": true,\\n\\n  \\\"projectManager.git.baseFolders\\\": [\\\"/home/julien/Documents\\\"],\\n\\n  // INTERFACE -------------------------------------------------------------------\\n\\n  \\\"explorer.confirmDragAndDrop\\\": false,\\n  \\\"explorer.confirmDelete\\\": false,\\n  \\\"extensions.autoRestart\\\": true,\\n  \\\"testing.resultsView.layout\\\": \\\"treeLeft\\\",\\n\\n  // POSITRON --------------------------------------------------------------------\\n\\n  \\\"console.fontFamily\\\": \\\"'Fira Code', 'monospace'\\\",\\n  \\\"console.fontSize\\\": 12,\\n  \\\"console.fontLigatures\\\": true,\\n  \\\"debug.console.fontSize\\\": 11,\\n\\n  \\\"packages.r.installer\\\": \\\"pak\\\",\\n  \\\"positron.r.quietMode\\\": true,\\n  \\\"positron.r.customBinaries\\\": [\\\"/opt/R/4.6.0/bin/R\\\"],\\n  \\\"positron.r.interpreters.default\\\": \\\"/opt/R/4.6.0/bin/R\\\",\\n  \\\"positron.assistant.enable\\\": false,\\n  \\\"plots.darkFilter\\\": \\\"off\\\",\\n  \\\"positron.viewer.openLocalhostUrls\\\": false,\\n\\n  // EXTENSIONS ------------------------------------------------------------------\\n\\n  \\\"errorLens.delay\\\": 500,\\n  \\\"errorLens.padding\\\": \\\"0px\\\",\\n\\n  \\\"material-icon-theme.files.associations\\\": {\\n    \\\".Rprofile\\\": \\\"r\\\",\\n    \\\".Renviron\\\": \\\"r\\\",\\n    \\\"DESCRIPTION\\\": \\\"r\\\",\\n    \\\"NAMESPACE\\\": \\\"r\\\",\\n    \\\"_targets.R\\\": \\\"r\\\",\\n    \\\".Rbuildignore\\\": \\\"settings\\\",\\n    \\\"renv.lock\\\": \\\"lock\\\",\\n    \\\"rv.lock\\\": \\\"lock\\\",\\n    \\\"*.Rproj\\\": \\\"r\\\",\\n    \\\"*.ggsql\\\": \\\"sql\\\",\\n  },\\n\\n  \\\"material-icon-theme.folders.associations\\\": {\\n    \\\"man\\\": \\\"mock\\\",\\n    \\\"renv\\\": \\\"packages\\\",\\n    \\\"rv\\\": \\\"packages\\\",\\n    \\\"vignettes\\\": \\\"docs\\\",\\n  },\\n\\n  \\\"quartoWizard.ask.trustAuthors\\\": \\\"never\\\",\\n\\n  // RÉSEAU ET CONTENEURS --------------------------------------------------------\\n\\n  \\\"json.schemaDownload.enable\\\": false,\\n  \\\"remote.autoForwardPortsSource\\\": \\\"hybrid\\\",\\n\\n  // CLAUDE CODE -----------------------------------------------------------------\\n\\n  \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\n  \\\"claudeCode.selectedModel\\\": \\\"opus\\\",\\n  \\\"chat.useAgentSkills\\\": false,\\n\\n  // APPARENCE GLOBALE -----------------------------------------------------------\\n\\n  \\\"workbench.colorTheme\\\": \\\"Material Night Eighties\\\",\\n  \\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\",\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n  \\\"workbench.settings.editor\\\": \\\"json\\\",\\n  \\\"workbench.editor.highlightModifiedTabs\\\": true,\\n  \\\"workbench.editor.enablePreview\\\": false,\\n  \\\"workbench.editor.empty.hint\\\": \\\"hidden\\\",\\n  \\\"workbench.tree.renderIndentGuides\\\": \\\"always\\\",\\n  \\\"workbench.keybindings.rstudioKeybindings\\\": true,\\n\\n  \\\"window.title\\\": \\\"${activeEditorFull}${separator}${rootName}\\\",\\n  // \\\"window.zoomLevel\\\": 0.1,\\n\\n  // COLORATION SYNTAXIQUE -------------------------------------------------------\\n\\n  \\\"editor.tokenColorCustomizations\\\": {\\n    \\\"[Material Night Purple]\\\": {\\n      \\\"textMateRules\\\": [\\n        {\\n          \\\"name\\\": \\\"Comment\\\",\\n          \\\"scope\\\": [\\\"comment\\\", \\\"punctuation.definition.comment\\\"],\\n          \\\"settings\\\": {\\n            \\\"foreground\\\": \\\"#888\\\",\\n          },\\n        },\\n      ],\\n    },\\n    \\\"textMateRules\\\": [\\n      {\\n        \\\"name\\\": \\\"Text and Source Base\\\",\\n        \\\"scope\\\": [\\\"text\\\", \\\"source\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#CDD3DE\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Variable\\\",\\n        \\\"scope\\\": [\\n          \\\"variable\\\",\\n          \\\"variable.parameter\\\",\\n          \\\"source.python\\\",\\n          \\\"source.python meta.function-call.arguments.python\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#ffffff\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Constant Numeric\\\",\\n        \\\"scope\\\": [\\\"constant.numeric\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#ff7869\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Constant Language\\\",\\n        \\\"scope\\\": [\\\"constant.language\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#ffbc6a\\\",\\n          \\\"fontStyle\\\": \\\"bold\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Constant Other\\\",\\n        \\\"scope\\\": [\\\"constant\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#F77669\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"String\\\",\\n        \\\"scope\\\": [\\n          \\\"string\\\",\\n          \\\"constant.other.symbol\\\",\\n          \\\"entity.other.inherited-class\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#c5ff93\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Punctuation Separator / Operator\\\",\\n        \\\"scope\\\": [\\n          \\\"punctuation.separator.arguments.python\\\",\\n          \\\"punctuation.separator.element.python\\\",\\n          \\\"punctuation.separator.period.python\\\",\\n          \\\"keyword.operator\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#a2fff6\\\",\\n          \\\"fontStyle\\\": \\\"\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Keyword\\\",\\n        \\\"scope\\\": [\\\"keyword\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#d08aff\\\",\\n          \\\"fontStyle\\\": \\\"bold\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Storage\\\",\\n        \\\"scope\\\": [\\\"storage\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#d08aff\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Function\\\",\\n        \\\"scope\\\": [\\n          \\\"entity.name.function\\\",\\n          \\\"meta.function-call support.type\\\",\\n          \\\"meta.function-call support.function\\\",\\n          \\\"meta.function-call.generic\\\",\\n          \\\"support.function\\\",\\n          \\\"keyword.other.special-method\\\",\\n          \\\"variable.function\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#90e1ff\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Namespace\\\",\\n        \\\"scope\\\": [\\\"entity.name.namespace.r\\\", \\\"storage.type.function.python\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#FAD430\\\",\\n          \\\"fontStyle\\\": \\\"bold\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Punctuation Definition\\\",\\n        \\\"scope\\\": [\\n          \\\"punctuation.definition.string\\\",\\n          \\\"punctuation.definition.variable\\\",\\n          \\\"punctuation.definition.parameters\\\",\\n          \\\"punctuation.definition.array\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#d9f5dd\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Class\\\",\\n        \\\"scope\\\": [\\n          \\\"support.class\\\",\\n          \\\"entity.name.class\\\",\\n          \\\"entity.name.type.class\\\",\\n          \\\"variable.language.this.js\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#ffcb6b\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Meta Class\\\",\\n        \\\"scope\\\": [\\\"meta.class\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#ffffff\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Support (tags, misc)\\\",\\n        \\\"scope\\\": [\\n          \\\"meta.tag\\\",\\n          \\\"punctuation.definition.tag\\\",\\n          \\\"punctuation.separator.inheritance.php\\\",\\n          \\\"punctuation.definition.tag.html\\\",\\n          \\\"punctuation.definition.tag.begin.html\\\",\\n          \\\"punctuation.definition.tag.end.html\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#80CBC4\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Tag Name\\\",\\n        \\\"scope\\\": [\\\"entity.name.tag\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#ff5370\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Attribute\\\",\\n        \\\"scope\\\": [\\\"entity.other.attribute-name\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#ffcb6b\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Attribute ID\\\",\\n        \\\"scope\\\": [\\n          \\\"entity.other.attribute-name.id\\\",\\n          \\\"constant.other.caps.python\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#FAD430\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Heading\\\",\\n        \\\"scope\\\": [\\n          \\\"markup.heading punctuation.definition.heading\\\",\\n          \\\"entity.name.section\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#78ccf0\\\",\\n          \\\"fontStyle\\\": \\\"\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Bold\\\",\\n        \\\"scope\\\": [\\\"markup.bold\\\", \\\"punctuation.definition.bold\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#ffcb6b\\\",\\n          \\\"fontStyle\\\": \\\"bold\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Italic\\\",\\n        \\\"scope\\\": [\\\"markup.italic\\\", \\\"punctuation.definition.italic\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#c792ea\\\",\\n          \\\"fontStyle\\\": \\\"italic\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Markup Fenced Code / Quarto Raw\\\",\\n        \\\"scope\\\": [\\n          \\\"markup.fenced_code.block.markdown\\\",\\n          \\\"markup.inline.raw.string.quarto\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#c5ff93\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Quarto Bold/Italic (no style override)\\\",\\n        \\\"scope\\\": [\\\"markup.bold.quarto\\\", \\\"markup.italic.quarto\\\"],\\n        \\\"settings\\\": {\\n          \\\"fontStyle\\\": \\\"\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Quarto Shortcode Import\\\",\\n        \\\"scope\\\": [\\\"keyword.control.import.shortcode\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#ffffff\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Quarto Cell Option Separator\\\",\\n        \\\"scope\\\": [\\\"punctuation.separator.key-value.cell-option.quarto\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#CDD3DE\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Quarto Div Heading\\\",\\n        \\\"scope\\\": [\\\"markup.heading.div.quarto\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#d08aff\\\",\\n          \\\"fontStyle\\\": \\\"bold\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Markup List\\\",\\n        \\\"scope\\\": [\\\"markup.list\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#CDD3DE\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"SQL Database/Table Names\\\",\\n        \\\"scope\\\": [\\n          \\\"constant.other.database-name.sql\\\",\\n          \\\"constant.other.table-name.sql\\\",\\n        ],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#90e1ff\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Inline Code\\\",\\n        \\\"scope\\\": [\\\"markup.raw.inline\\\"],\\n        \\\"settings\\\": {\\n          \\\"foreground\\\": \\\"#f1e655\\\",\\n        },\\n      },\\n      {\\n        \\\"name\\\": \\\"Link Text\\\",\\n        \\\"scope\\\": [\\n   